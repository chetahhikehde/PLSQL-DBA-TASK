      BEGIN
        IF i.type = 'PACKAGE' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('PACKAGE', NAME, 'SSS') FROM DUAL; 
           SELECT DBMS_METADATA.GET_DDL('PACKAGE', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL; 
        ELSIF i.type = 'PACKAGE BODY' THEN 
