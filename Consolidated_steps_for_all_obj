          SELECT DBMS_METADATA.GET_DDL('PACKAGE_BODY', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL;
        ELSIF i.type = 'FUNCTION' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('PACKAGE', NAME, 'SSS') FROM DUAL; 
           SELECT DBMS_METADATA.GET_DDL('FUNCTION', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL; 
        ELSIF i.type = 'PROCEDURE' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('PACKAGE', NAME, 'SSS') FROM DUAL; 
           SELECT DBMS_METADATA.GET_DDL('PROCEDURE', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL; 
        ELSIF i.type = 'LIBRARY' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('LIBRARY', NAME, 'SSS') FROM DUAL; 
           SELECT DBMS_METADATA.GET_DDL('LIBRARY', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL;
        ELSIF i.type = 'TRIGGER' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('TRIGGER', NAME, 'SSS') FROM DUAL; 
           SELECT DBMS_METADATA.GET_DDL('TRIGGER', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL;      
        ELSIF i.type = 'TYPE' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('TYPE', NAME, 'SSS') FROM DUAL; 
           SELECT DBMS_METADATA.GET_DDL('TYPE', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL;    
      ELSIF i.type = 'TYPE BODY' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('TYPE BODY', NAME, 'SSS') FROM DUAL; 
          SELECT DBMS_METADATA.GET_DDL('TYPE BODY', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL;       
      ELSIF i.type = 'JAVA SOURCE' THEN 
          --v_pack_clob:= SELECT DBMS_METADATA.GET_DDL('JAVA SOURCE', NAME, 'SSS') FROM DUAL; --METADAT NOT SUPPORTED
          SELECT DBMS_METADATA.GET_DDL('JAVA SOURCE', i.NAME, 'SSS') INTO v_pack_clob FROM DUAL;     
        END IF;
       EXCEPTION WHEN OTHERS THEN NULL;
       END;
      -- Initilaizing the value of nested table colums using v_num --
      -- tab1_nestab.extend; --> very imp while using nested table, (not required in ASS ARRAY)
      
      tab1_nestab(v_num).slno:=v_num;

      IF    i.type = 'PACKAGE' THEN
         tab1_nestab(v_num).package_name:=i.NAME;
      ELSIF i.type = 'PACKAGE BODY' THEN
         tab1_nestab(v_num).package_body_name:=i.NAME;
      ELSIF i.type = 'PROCEDURE' THEN
         tab1_nestab(v_num).proc_name:=i.NAME;
      ELSIF i.type = 'FUNCTION' THEN
         tab1_nestab(v_num).fun_name:=i.NAME;
      ELSIF i.type = 'LIBRARY' THEN
         tab1_nestab(v_num).library_name:=i.NAME;
      ELSIF i.type = 'TRIGGER' THEN
         tab1_nestab(v_num).tri_gger_name:=i.NAME;
      ELSIF i.type = 'TYPE' THEN
         tab1_nestab(v_num).type_name:=i.NAME;
      ELSIF i.type = 'TYPE BODY' THEN
         tab1_nestab(v_num).type_body_name:=i.NAME;
      ELSIF i.type = 'JAVA SOURCE' THEN
         tab1_nestab(v_num).java_source_name:=i.NAME;                         
      END IF;
      
      tab1_nestab(v_num).code:=v_pack_clob;  
      --BELOW INSERTION IS ONE BY ONE, NOT IN IN A BULK.--
      /*
      IF v_pack_clob is not null then
