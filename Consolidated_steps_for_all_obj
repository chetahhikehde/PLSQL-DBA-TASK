CREATE TABLE tab1(SLNO int,TYPE_name Varchar2(100), type_body_name Varchar2(100),PACKAGE_NAME Varchar2(100),PACKAGE_BODY_NAME VARCHAR2(100),library_name Varchar2(100),java_source_name Varchar2(100),tri_gger_name Varchar2(100),PROC_NAME VARCHAR2(100), FUN_NAME VARCHAR2(100), CODE CLOB); 

CREATE TABLE TAB1_VAR (
  SLNO                 INTEGER,
  TYPE_NAME            VARCHAR2(100),
  TYPE_BODY_NAME       VARCHAR2(100),
  PACKAGE_NAME         VARCHAR2(100),
  PACKAGE_BODY_NAME    VARCHAR2(100),
  LIBRARY_NAME         VARCHAR2(100),
  JAVA_SOURCE_NAME     VARCHAR2(100),
  TRI_GGER_NAME        VARCHAR2(100),
  PROC_NAME            VARCHAR2(100),
  FUN_NAME             VARCHAR2(100),
  CODE_SL_NO           INTEGER,
  CODE                 VARCHAR2(4000)
);
