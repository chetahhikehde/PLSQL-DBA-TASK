/*Step 3: Run below script*/ -------------------------

DECLARE
  -- Target record type and nested table
  TYPE tab1_var_tab_type IS TABLE OF tab1_var%ROWTYPE;
  tab1_var_tab tab1_var_tab_type := tab1_var_tab_type();

  -- Constants and counters
  v_chunk_size    CONSTANT PLS_INTEGER := 4000;
  v_code_length   PLS_INTEGER;
  v_chunk_start   PLS_INTEGER := 1;
  v_code_sl_no    PLS_INTEGER := 1;
  j               PLS_INTEGER := 1;

BEGIN
  -- Loop through tab1 source records
  FOR rec IN (
    SELECT * FROM tab1
  ) LOOP
    v_code_length := DBMS_LOB.GETLENGTH(rec.code);

    IF v_code_length > v_chunk_size THEN
      v_chunk_start := 1;
      v_code_sl_no  := 1;

      WHILE v_chunk_start <= v_code_length LOOP
        tab1_var_tab.EXTEND;

        tab1_var_tab(j).slno               := rec.slno;
        tab1_var_tab(j).type_name          := rec.type_name;
        tab1_var_tab(j).type_body_name     := rec.type_body_name;
        tab1_var_tab(j).package_name       := rec.package_name;
        tab1_var_tab(j).package_body_name  := rec.package_body_name;
        tab1_var_tab(j).library_name       := rec.library_name;
        tab1_var_tab(j).java_source_name   := rec.java_source_name;
        tab1_var_tab(j).tri_gger_name      := rec.tri_gger_name;
        tab1_var_tab(j).proc_name          := rec.proc_name;
        tab1_var_tab(j).fun_name           := rec.fun_name;
        tab1_var_tab(j).code_sl_no         := v_code_sl_no;
        tab1_var_tab(j).code               := DBMS_LOB.SUBSTR(rec.code, v_chunk_size, v_chunk_start);

        v_chunk_start := v_chunk_start + v_chunk_size;
        v_code_sl_no  := v_code_sl_no + 1;
        j := j + 1;
      END LOOP;

    ELSE
      tab1_var_tab.EXTEND;

      tab1_var_tab(j).slno               := rec.slno;
      tab1_var_tab(j).type_name          := rec.type_name;
      tab1_var_tab(j).type_body_name     := rec.type_body_name;
      tab1_var_tab(j).package_name       := rec.package_name;
      tab1_var_tab(j).package_body_name  := rec.package_body_name;
      tab1_var_tab(j).library_name       := rec.library_name;
      tab1_var_tab(j).java_source_name   := rec.java_source_name;
      tab1_var_tab(j).tri_gger_name      := rec.tri_gger_name;
      tab1_var_tab(j).proc_name          := rec.proc_name;
      tab1_var_tab(j).fun_name           := rec.fun_name;
      tab1_var_tab(j).code_sl_no         := 1;
      tab1_var_tab(j).code               := DBMS_LOB.SUBSTR(rec.code, v_chunk_size, 1);

      j := j + 1;
    END IF;
  END LOOP;

  -- Bulk insert into TAB1_VAR
  FORALL i IN tab1_var_tab.FIRST .. tab1_var_tab.LAST SAVE EXCEPTIONS
    INSERT INTO tab1_var (
      slno, type_name, type_body_name, package_name, package_body_name,
      library_name, java_source_name, tri_gger_name,
      proc_name, fun_name, code_sl_no, code
    )
    VALUES (
      tab1_var_tab(i).slno,
      tab1_var_tab(i).type_name,
      tab1_var_tab(i).type_body_name,
      tab1_var_tab(i).package_name,
      tab1_var_tab(i).package_body_name,
      tab1_var_tab(i).library_name,
      tab1_var_tab(i).java_source_name,
      tab1_var_tab(i).tri_gger_name,
      tab1_var_tab(i).proc_name,
      tab1_var_tab(i).fun_name,
      tab1_var_tab(i).code_sl_no,
      tab1_var_tab(i).code
    );

  COMMIT;

EXCEPTION
  WHEN OTHERS THEN
    DBMS_OUTPUT.PUT_LINE('Bulk insert failed. Error details:');
    FOR idx IN 1 .. SQL%BULK_EXCEPTIONS.COUNT LOOP
      DBMS_OUTPUT.PUT_LINE(
        'Error #' || SQL%BULK_EXCEPTIONS(idx).ERROR_CODE ||
        ' at index ' || SQL%BULK_EXCEPTIONS(idx).ERROR_INDEX
      );
    END LOOP;
    ROLLBACK;
END;

